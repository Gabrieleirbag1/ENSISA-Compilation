package fr.uha.hassenforder.cage.xon;

parser import code {:
import java.util.List;
import fr.uha.hassenforder.cage.xon.model.xon.Node;
import fr.uha.hassenforder.cage.xon.model.xon.NodeFactory;
:}

parser code {:
    
    private NodeFactory factory = null;

    public NodeFactory getFactory () {
        if (factory == null) {
            factory = new NodeFactory ();
        }
        return factory;
    }
:}

parser action code {:
    public NodeFactory getFactory () {
        return parser.getFactory();
    }
:}

terminal String			STRING;
terminal Integer		INTEGER;
terminal Double			DOUBLE;
terminal Boolean		BOOLEAN;   

nonterminal Node		json, object, pair;
nonterminal	Node		array, element, let;
nonterminal	Node		value;
nonterminal Node 	    Expression;
nonterminal	Node		condition;
nonterminal	Node		loop;
nonterminal	List<Node>	members, elements;

precedence left '+', '-';
precedence left '*', '/';
precedence left '==', '!=';
precedence left '<', '>', '<=', '>=';

start with json;

json		::=	object:o					{:
                                                RESULT = getFactory ().createJsonNode(o);
                                            :}
            ;
            
object		::= '{' members:list '}'		{:	RESULT = getFactory ().createObjectNode(list); :}
            ;

members		::=	pair:f ( ',' pair:n {: RESULT = n; :} ) *: list
                                            {:
                                                list.add(0, f);
                                                RESULT = list;
                                            :}
            ;

pair		::= STRING:n ':' value:v		{:	RESULT = getFactory ().createPairNode(n, v); :}
			| let:l							{: RESULT = l; :}
            ;

value		::=	object:o					{:	RESULT = o; :}
            |	array:a						{:	RESULT = a; :}
            |	Expression:e				{:	RESULT = e; :}
            ;

array		::=	'[' elements:list ']'		{:	RESULT = getFactory ().createArrayNode(list); :}
            ;

elements	::=	element:f ( ',' element:n {: RESULT = n; :} ) *:list
                                            {:
                                                list.add(0, f);
                                                RESULT = list;
                                            :}
            ;

element		::=	value:v						{:	RESULT = v; :}
			|	let:l						{:	RESULT = l; :}
            ;

let		::=	'let' STRING:n '=' Expression:v	{: RESULT = getFactory().createLetNode(n, v); :}
        |   STRING:n '=' Expression:v			{: RESULT = getFactory().createLetNode(n, v); :}
		;

condition   ::= 'if' Expression:cond 'then' Expression:thenExpr 'else' Expression:elseExpr
            {: RESULT = getFactory().createIfNode(cond, thenExpr, elseExpr); :}
            ;

loop        ::= 'for' STRING:var 'in' value:iter 'do' value:body
            {:
                Node iterNode = iter;
                // If iter is an array, we can use it directly for iteration
                // If iter is a simple expression (like an integer), we can use it for counting
                RESULT = getFactory().createLoopNode(var, iterNode,
                    body.getType() == fr.uha.hassenforder.cage.xon.model.xon.NodeType.ARRAY
                        ? body.getChildren()
                        : java.util.Arrays.asList(body)
                );
            :}
            ;

Expression	::= STRING:v					{:	RESULT = getFactory().createStringNode(v); :}
            |	Expression:e1 '+' Expression:e2	{: RESULT = getFactory().createAddNode(e1, e2); :}
            |	Expression:e1 '-' Expression:e2	{: RESULT = getFactory().createSubNode(e1, e2); :}
            |	Expression:e1 '*' Expression:e2	{: RESULT = getFactory().createMultNode(e1, e2); :}
            |	Expression:e1 '/' Expression:e2	{: RESULT = getFactory().createDivNode(e1, e2); :}
            |   Expression:e1 '==' Expression:e2	{: RESULT = getFactory().createEqualsNode(e1, e2); :}
            |   Expression:e1 '!=' Expression:e2	{: RESULT = getFactory().createNotEqualsNode(e1, e2); :}
            |   Expression:e1 '<' Expression:e2	{: RESULT = getFactory().createLessThanNode(e1, e2); :}
            |   Expression:e1 '>' Expression:e2	{: RESULT = getFactory().createGreaterThanNode(e1, e2); :}
            |   Expression:e1 '<=' Expression:e2	{: RESULT = getFactory().createLessThanOrEqualNode(e1, e2); :}
            |   Expression:e1 '>=' Expression:e2	{: RESULT = getFactory().createGreaterThanOrEqualNode(e1, e2); :}
            |	'(' Expression:e ')'			{: RESULT = e; :}
            |	DOUBLE:d					{: RESULT = getFactory().createRealNode(d); :}
            |	INTEGER:i					{: RESULT = getFactory().createIntegerNode(i); :}
            |	BOOLEAN:b					{: RESULT = getFactory().createBooleanNode(b); :}
            |	condition:c					{: RESULT = c; :}
            |   loop:l						{: RESULT = l; :}
            |   'get' STRING:name			{: RESULT = getFactory().createGetNode(name); :}
            ;
            

STRING	::=	`\"[^\"]*\"`	{: RESULT = new String( zzBuffer, zzStartRead+1, zzMarkedPos-zzStartRead-2 ); :}
        ;

INTEGER	::=	`[0-9]+`
        ;

DOUBLE	::=	`[0-9]+("."[0-9]+)?[eE][+-]?[0-9]+`
        |	`[0-9]*"."[0-9]+([eE][+-]?[0-9]+)?`
        ;

BOOLEAN ::= `true`  {: RESULT = Boolean.TRUE; :}
        | `false`   {: RESULT = Boolean.FALSE; :}
        ; 

terminal void EOLN, WHITE;

EOLN	::=	`\r\n|\r|\n`
        ;

WHITE	::=	`[ \t\f]`
        ;